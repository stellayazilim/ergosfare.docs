---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import SidebarLink from "./SidebarLink.astro";
import { Icon } from "@astrojs/starlight/components";

// extract SidebarGroup type to use as props
type SideBarGroup = Extract<StarlightRouteData['sidebar'][number], { type: 'group' }>
type SidebarLink =  Extract<StarlightRouteData['sidebar'][number], { type: 'link' }>
export interface Props extends SideBarGroup {
   depth: number
}

const { label, entries, type, depth, collapsed } = Astro.props

const firstLink = (entries.find(e => e.type === "link") as SidebarLink | undefined)?.href

---



<li   >

  <sidebar-persister data-collapsed={collapsed} data-label={label}> 
    <h2 class:list={[
      
        depth > 0 &&  "ml-3.5",
      "font-display font-medium text-slate-900 dark:text-white", 'flex items-center justify-between sidebar-group-heading'
      
    ]}>
      
      {/* A group whose first entry is itself a group has no page to link to. */}
      {firstLink ? <a href={firstLink}>{label}</a> : <span>{label}</span>}

      <button class="sidebar-collapse-btn"> <Icon  name="right-caret" class="sidebar-caret" /></button>
    </h2>

    <ul
      role="list"
      class:list={[
          "mt-4  border-slate-100 lg:mt-4 space-y lg:space-y-4 lg:border-slate-200 dark:border-slate-800",
          depth == 0 && 'border-l-2',
          collapsed && "hidden"
      ]}>

      {/* Entries are always rendered, even when collapsed — the collapse button
          toggles visibility client-side and has nothing to reveal otherwise. */}
      { type == "group" && entries.map(entry => {
          return entry.type == "group" ? <Astro.self {...entry} depth={depth + 1} />:
          <li class="relative"> <SidebarLink  depth={depth + 1} {...entry as SidebarLink} /> </li>
      })}

    </ul>
  </sidebar-persister> 
</li>




<script>
  import autoAnimate from "@formkit/auto-animate";


  interface ISidebarStatus {
    [key: string]: { collapsed: boolean }
  }
  class SidebarPersister extends HTMLElement {

  // `querySelector` from the host element reaches into nested groups too, so
  // scope both lookups to this group's own heading/list.
  collapseItem = this.querySelector(":scope > ul") as HTMLUListElement
  collapseBtn: HTMLButtonElement = this.querySelector(":scope > h2 .sidebar-collapse-btn") as HTMLButtonElement
  label: string = this.dataset.label || ""
  collapsed: boolean = this.dataset.collapsed === "true"
  onToggle = this.toggle.bind(this)

  constructor() {
    super();
  }

  set SidebarStatus(value: ISidebarStatus) {
    sessionStorage.setItem("sidebar", JSON.stringify(
      {...this.SidebarStatus, ...value}
    ))
  }

  get SidebarStatus(): ISidebarStatus {
    // Nothing stored yet on the first page view of a session; without this
    // fallback every read below is a null dereference.
    try {
      return JSON.parse(sessionStorage.getItem("sidebar") || "{}") as ISidebarStatus
    } catch {
      return {}
    }
  }

  connectedCallback() {
    if (!this.collapseItem || !this.collapseBtn) return

    this.collapseBtn.addEventListener("click", this.onToggle)

    // A state the reader chose wins over the config default; otherwise seed the
    // store with the default so it persists across navigations.
    const stored = this.SidebarStatus[this.label]
    if (stored) {
      this.collapsed = stored.collapsed
    } else {
      this.SidebarStatus = { [this.label]: { collapsed: this.collapsed } }
    }

    autoAnimate(this.collapseItem)
    this.render()
  }

  disconnectedCallback() {
      this.collapseBtn?.removeEventListener("click", this.onToggle)
  }

  render() {
      this.collapseItem.classList.toggle("hidden", this.collapsed)
      this.collapseItem.style.display = this.collapsed ? "none" : "block"
      const caret = this.querySelector(":scope > h2 .sidebar-caret") as HTMLElement | null;
      if (caret) {
        caret.style.transform = this.collapsed ? "rotate(0deg)" : "rotate(90deg)";
        caret.style.transition = "transform 0.2s ease";
      }
  }

  toggle() {
      this.collapsed = !this.collapsed
      this.SidebarStatus = { [this.label]: { collapsed: this.collapsed } }
      this.render()
  }


}

!customElements.get("sidebar-persister") && customElements.define("sidebar-persister", SidebarPersister)
</script>